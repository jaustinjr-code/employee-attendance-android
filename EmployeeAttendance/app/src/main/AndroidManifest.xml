<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Foreground location, used to detect proximity to registered work locations. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!--
        Background ("Allow all the time") location enables reliable proximity tracking and auto
        clock-in while the app is not in the foreground. Requested separately, after foreground
        access is granted, per the Android 10+ permission model.
    -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Foreground service that keeps background location tracking alive, with a visible
         notification. FOREGROUND_SERVICE_LOCATION is required on Android 14+. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Backup posture (issue #9). 100% of what this app persists is sensitive personal data —
        worksite coordinates, attendance clock-in/out history, proximity state, and the
        notification/privacy settings derived from them — so there is nothing left worth backing
        up. allowBackup="false" is therefore the fail-CLOSED default: anything added later is
        excluded automatically instead of being auto-included by an out-of-date deny list.

        allowBackup="false" alone is NOT sufficient. Per Android's backup docs: "On devices from
        some device manufacturers, specifying android:allowBackup='false' does disable backups to
        Google Drive, but doesn't disable D2D transfers for the app." Device-to-device transfer is
        governed by @xml/data_extraction_rules, so the rule files stay, and stay exhaustive: they
        block D2D
        transfer today, and they are defence in depth for cloud backup should allowBackup ever be
        turned back on. @xml/backup_rules covers API < 31 (minSdk is 24).

        BackupRulesTest asserts allowBackup stays false and that every store following the
        PREFS_NAME convention has exclude entries in all three rule sections.
    -->
    <application
        android:name=".EmployeeAttendanceApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EmployeeAttendance">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.EmployeeAttendance">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".location.tracking.LocationTrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <receiver
            android:name=".location.geofence.GeofenceBroadcastReceiver"
            android:exported="false" />

        <!-- Handles the Undo/Confirm actions on automatic clock-in/out notifications. -->
        <receiver
            android:name=".attendance.ClockActionReceiver"
            android:exported="false" />
    </application>

</manifest>