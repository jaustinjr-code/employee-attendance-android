    <!-- Location permission rationale: initial "enable" prompt -->
    <string name="location_permission_enable_title">Enable Auto Clock-In?</string>
    <string name="location_permission_enable_body">When you\'re near a designated work location, we can clock you in automatically. When you leave, we\'ll clock you out. This helps ensure your hours are recorded accurately.</string>
    <string name="location_permission_enable_confirm">Enable Location Services</string>
    <string name="location_permission_dismiss">Maybe Later</string>

    <!-- Location permission rationale: foreground permanently denied, must go to Settings -->
    <string name="location_permission_blocked_body">Location permission is turned off for this app, so auto clock-in can\'t run. To enable it, allow location access in Settings.</string>
