    <!-- Location permission rationale: initial "enable" prompt -->
    <string name="location_permission_enable_title">Enable Auto Clock-In?</string>
    <string name="location_permission_enable_body">When you\'re near a designated work location, we can clock you in automatically. When you leave, we\'ll clock you out. This helps ensure your hours are recorded accurately.</string>
    <string name="location_permission_enable_confirm">Enable Location Services</string>
    <string name="location_permission_dismiss">Maybe Later</string>

    <!-- Location permission rationale: foreground permanently denied, must go to Settings -->
    <string name="location_permission_blocked_body">Location permission is turned off for this app, so auto clock-in can\'t run. To enable it, allow location access in Settings.</string>
    <string name="location_permission_open_settings">Open Settings</string>

    <!-- Location permission rationale: upgrade from "While Using App" to "Allow all the time" -->
    <string name="location_permission_upgrade_title">Allow Location All the Time?</string>
    <string name="location_permission_upgrade_body">Auto clock-in works best when the app can check your location in the background. With “While Using the App” access, we can only detect your work location while the app is open, so clock-ins may be missed or delayed. Turn on “Allow all the time” to enable it.</string>
    <string name="location_permission_upgrade_confirm">Open Settings</string>
    <string name="location_permission_upgrade_confirm_inline">Allow All the Time</string>

    <!-- Degraded-mode messaging -->
    <string name="location_permission_degraded_notice">Limited location access: auto clock-in only works while the app is open.</string>
    <string name="location_approximate_notice">Approximate location only. Automatic clock-in may be unreliable — turn on Precise location for accuracy. You can still clock in and out manually.</string>

