<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.EmployeeAttendance" parent="android:Theme.Material.Light.NoActionBar" />

    <!--
        MainActivity's launch theme. installSplashScreen() swaps it for postSplashScreenTheme before
        the first frame. The animation duration is the animated icon's length; the activity holds
        the system splash until it has played (MainActivity's exit-animation listener) and then
        continues the sequence itself in ui/splash/BrandSplash.kt.
    -->
    <style name="Theme.EmployeeAttendance.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_sky_blue</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_screen_icon</item>
        <item name="windowSplashScreenAnimationDuration">950</item>
        <item name="postSplashScreenTheme">@style/Theme.EmployeeAttendance</item>
    </style>
</resources>
